{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Cride24/enhanced-questlog-vibe-coded",
        "sources": "https://github.com/Cride24/enhanced-questlog-vibe-coded",
        "issues": "https://github.com/Cride24/enhanced-questlog-vibe-coded/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.infernalstudios.questlog.QuestlogFabric"
        ],
        "client": [
            "org.infernalstudios.questlog.QuestlogFabric"
        ],
        "modmenu": [
            "org.infernalstudios.questlog.compat.modmenu.QuestlogModMenuIntegration"
        ],
        "jei_mod_plugin": [
            "org.infernalstudios.questlog.client.integration.JeiRecipeViewer"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
